# Copy this file to .env and replace every placeholder with your own values.
# Never commit .env or put real credentials in this example file.

# Backend API
PORT=8080

# Local MySQL Server (create the database/user in MySQL Workbench first,
# or use the provided Docker Compose configuration).
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=lyys_store
MYSQL_PASSWORD=replace-with-your-mysql-user-password
MYSQL_DATABASE=lyys_store
MYSQL_ROOT_PASSWORD=replace-with-your-mysql-root-password
MYSQL_SYNCHRONIZE=true

# Legacy MongoDB connection; only needed if a feature still uses MongoDB.
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>/<database>

# Authentication
JWT_ACCESS_TOKEN_SECRET=replace-with-a-long-random-secret

# Email (Gmail app password or credentials for your SMTP provider)
MAIL_USER=your-email@example.com
MAIL_PASSWORD=replace-with-your-email-app-password

# News API
API_KEY_NEWS=replace-with-your-news-api-key
